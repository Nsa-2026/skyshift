# Build context for the root Dockerfile (server/ + core/). Keep it small.
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/node_modules
.git
.claude
.env
.env.*
*-key.json
service-account*.json
web/*
!web/public/
web/public/*
!web/public/data/
!web/public/science-data/
# The server reads only the featured fields' index/frames/object files (exports.py); not the
# candidate cutouts.
web/public/data/cand/
docs/
pitch/
pipeline/
infra/
fixtures/fits/
scripts/
!scripts/validate/data/targets.json
**/*.fits
**/*.parquet
core/tests/
server/tests/

# Local jobs, tool installs and release verification never enter the cloud build.
.runtime/
