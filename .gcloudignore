**/.venv/
**/__pycache__/
**/node_modules/
.env
.env.*
*-key.json
service-account*.json
web/dist/
docs/
pitch/
pipeline/
infra/
fixtures/fits/
**/*.fits
**/*.parquet
scripts/precompute/
scripts/validate/*.py
scripts/validate/data/photolists/
scripts/validate/data/most_*
