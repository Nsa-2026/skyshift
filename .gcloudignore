# Upload for `gcloud run deploy --source .` (infra/run/deploy.sh). Only what the root Dockerfile uses.
.gcloudignore
.git
.gitignore
.claude/
**/.venv/
**/__pycache__/
**/node_modules/
.env
.env.*
*-key.json
service-account*.json
web/*
!web/public/
web/public/*
!web/public/data/
!web/public/science-data/
# The server reads only the featured fields' index/frames/object files (exports.py); not the
# candidate cutouts.
web/public/data/cand/
docs/
pitch/
pipeline/
infra/
fixtures/fits/
**/*.fits
**/*.parquet
scripts/precompute/
scripts/validate/*.py
scripts/validate/data/photolists/
scripts/validate/data/most_*

# Local jobs, tool installs and release verification never enter the cloud build.
.runtime/
